BOT_TOKEN=xxxxxxxx
TELEGRAM_CHANNEL_ID=-100xxxxxxxx

# The discussion/chat group where users can talk freely and use user commands
# (not the channel — the channel is announcement-only). Group IDs are numeric
# and negative (e.g. -1001234567890).
# DISCUSSION_GROUP_ID=-1001234567890

# Public @usernames (no @) for the footer links shown on every module card.
# CHANNEL_USERNAME=mychannel
# DISCUSSION_USERNAME=mydiscussion

# Optional. If set, DELETE /api/modules/{id} and DELETE /api/posts/{id}
# require this token via the X-Admin-Token header (dashboard UI prompts for it).
# Leave empty to allow deletes with no guard (local use only).
# DASHBOARD_ADMIN_TOKEN=

# Comma separated list of admin Telegram user IDs
ADMIN_IDS=123456789

# SQLite by default; later you can switch to PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/modulab
DATABASE_URL=sqlite:///data/modulab.db

# Optional: GitHub token for higher rate limits / private repos
# GITHUB_TOKEN=ghp_xxx

# Webhook for auto-announcing GitHub releases
# WEBHOOK_SECRET=mysecret
# WEBHOOK_PORT=8080
# Auto-announce only these repos, comma separated (empty = announce all):
# AUTO_ANNOUNCE_REPOS=owner/repo1,owner/repo2

# Optional: allow the bot to run in test-free mode
# LOG_LEVEL=INFO
